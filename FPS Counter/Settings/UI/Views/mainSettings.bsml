<settings-container xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
					xsi:noNamespaceSchemaLocation='https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
	<increment-setting text='FPS Update rate' value='update-rate'
					   min='0.1' increment='0.1' apply-on-change='true'/>
	<bool-setting text='Use FPS Colors' value='use-colors' apply-on-change='true'/>
	<bool-setting text='Show FPS ring' value='show-ring' apply-on-change='true'/>
	<slider-setting text='X Position' value='pos-x' min='-10' max='10' increment='0.1' apply-on-change='true'/>
	<slider-setting text='Y Position' value='pos-y' min='-10' max='10' increment='0.1' apply-on-change='true'/>
	<slider-setting text='Z Position' value='pos-z' min='-10' max='10' increment='0.1' apply-on-change='true'/>

</settings-container>